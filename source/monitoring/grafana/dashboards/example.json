          },
          "pluginVersion": "4.11.2",
          "queryType": "timeseries",
          "rawSql": "WITH (\n    SELECT\n        argMaxMerge(peak_ts) as peak_ts\n    FROM\n        profiling.memory_peaks\n    WHERE\n        process_id == ${process_id}\n        AND value_type == 'active_size'\n) as max_rss\nSELECT\n    b.label ||'::'|| b.location as label,\n    level,\n    total_value as value,\n    self_value as self,\n    label_id\nFROM \n(\n    SELECT\n        label_id,\n        order_id,\n        level,\n        self_value,\n        total_value\n    FROM\n        profiling.flamegraphs\n    WHERE\n        timestamp == max_rss\n        AND process_id = ${process_id}\n        AND value_type == 'active_size'\n) as a\nINNER JOIN \n(\n    SELECT\n        label_id,\n        label,\n        location\n    FROM\n        profiling.localized_name\n    WHERE\n        process_id = ${process_id}\n) as b\nON (a.label_id == b.label_id)\nORDER BY (order_id)",
          "refId": "A"
        }
      ],
      "title": "Peak rss flamegraph (all time)",
