          "rawSql": "SELECT\n    timestamp as \"time\",\n    total_value as rss\nFROM\n    \"profiling\".\"timeseries\"\nWHERE \n    ( time >= $__fromTime AND time <= $__toTime )\n    AND ( process_id = $process_id )\n    AND label_id = 0\n    AND value_type = 'active_size'\nORDER BY time\nASC LIMIT 1000",
