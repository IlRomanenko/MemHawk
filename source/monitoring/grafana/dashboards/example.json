            }
          },
          "pluginVersion": "4.11.2",
          "queryType": "timeseries",
          "rawSql": "\nSELECT\n    label_id,\n    label || location || library,\n    total_value_diff,\n    self_value_diff\nFROM (\n    SELECT\n        label_id,\n        to.total_value - from.total_value as total_value_diff,\n        to.self_value - from.self_value as self_value_diff\n    FROM (\n        SELECT\n            label_id,\n            argMax(self_value, timestamp) as self_value,\n            argMax(total_value, timestamp) as total_value\n        FROM\n            \"profiling\".\"timeseries\"\n        WHERE \n            ( timestamp <= $__toTime )\n            AND ( process_id = $process_id )\n            AND value_type = 'active_size'\n        GROUP BY (label_id)\n    ) as to\n    LEFT JOIN (\n        SELECT\n            label_id,\n            argMax(self_value, timestamp) as self_value,\n            argMax(total_value, timestamp) as total_value\n        FROM\n            \"profiling\".\"timeseries\"\n        WHERE \n            ( timestamp <= $__fromTime )\n            AND ( process_id = $process_id )\n            AND value_type = 'active_size'\n        GROUP BY (label_id)\n    ) as from\n    ON to.label_id == from.label_id\n    WHERE total_value_diff != 0\n) as diffs\nINNER JOIN (\n    SELECT\n        label_id,\n        label,\n        location,\n        library\n    FROM\n        localized_name\n    WHERE\n        process_id = $process_id\n) as names\nON diffs.label_id == names.label_id\nORDER BY total_value_diff DESC",
          "refId": "A"
        }
      ],
