{
    "version": 8,
    "configurePresets": [
        {
            "name": "Debug",
            "displayName": "DevBuild Debug",
            "description": "Create debug build",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_CXX_FLAGS": "-O0 -g",
                "DIST_DEVBUILD_DIR": "${sourceDir}/out/dev_debug",
                "MEMHAWK_BUILD_TESTING": true,
                "BUILD_TESTING": false
            }
        },
        {
            "name": "RelWithDebInfo",
            "displayName": "DevBuild Release",
            "description": "Create release build",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_TOOLCHAIN_FILE": "",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_CXX_FLAGS": "-O3 -g -march=native -mavx2",
                "DIST_DEVBUILD_DIR": "${sourceDir}/out/dev",
                "MEMHAWK_BUILD_TESTING": true,
                "BUILD_TESTING": false
            }
        }
    ]
}