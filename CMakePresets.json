{
    "version": 6,
    "configurePresets": [
        {
            "name": "Debug",
            "displayName": "DevBuild Debug",
            "description": "Create debug build",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "DIST_DEVBUILD_DIR": "${sourceDir}/out/dev",
                "MEMHAWK_BUILD_TESTING": true
            }
        },
        {
            "name": "Release",
            "displayName": "Clang Release",
            "description": "Create release build without tests",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
            }
        },
        {
            "name": "ReleaseWithTests",
            "displayName": "Clang Release with tests",
            "description": "Create release build with tests",
            "inherits": ["Release"],
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "DIST_DEVBUILD_DIR": "${sourceDir}/out/dev",
                "MEMHAWK_BUILD_TESTING": true
            }
        },
        {
            "name": "ClangTidy",
            "displayName": "clang-tidy",
            "description": "Create clang-tidy build",
            "inherits": ["ReleaseWithTests"],
            "cacheVariables": {
                "MEMHAWK_USE_CLANG_TIDY": true
            }
        },
        {
            "name": "SanitizeAsan",
            "displayName": "Asan build",
            "description": "Compile with -fsanitize=address,undefined",
            "inherits": ["ReleaseWithTests"],
            "cacheVariables": {
                "ASAN": true
            }
        },
        {
            "name": "SanitizeTsan",
            "displayName": "Tsan build",
            "description": "Compile with -fsanitize=thread",
            "inherits": ["ReleaseWithTests"],
            "cacheVariables": {
                "TSAN": true
            }
        }
    ]
}